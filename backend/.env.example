# Cross-origin: frontend origin allowed by Nest CORS (see src/main.ts)
CORS_ORIGIN=http://localhost:3000

PORT=3001

# PostgreSQL (TypeORM)
# Schema changes: see doc/database-migrations/MIGRATIONS.md
# Docker: docker run --name postgres-db -e POSTGRES_USER=... -e POSTGRES_PASSWORD=... -e POSTGRES_DB=... -p 5432:5432 -d postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Dawntabase
DB_USER=maneka
DB_PASSWORD=your_password_here

# JWT (user auth)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=1h

# Default admin (seeded by migration AddUserRoleAndSeedAdmin — change password after first login)
# Email: admin@banshee.local
# Password: BansheeAdmin123!

# External banking inquiry API
BANKING_API_BASE_URL=http://34.21.206.87:3000
BANKING_API_KEY=your_banking_api_key_here

# Azure AI Foundry / Azure OpenAI (fraud analysis on imported customers)
# Option A — Azure OpenAI (cognitiveservices.azure.com): use the resource base URL only
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_AI_FOUNDRY_API_KEY=your_api_key_here
AZURE_AI_FOUNDRY_DEPLOYMENT=your_deployment_name
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21
# Option B — paste the full Target URL from the portal (also supported)
# AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2024-10-21
# Option C — Foundry model inference (services.ai.azure.com)
# AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/models
